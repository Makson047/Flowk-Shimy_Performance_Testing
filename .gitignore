.idea/
.env

# Node artifact files
node_modules/
dist/
.DS_Store

# build artifacts from tests
load-tests/summary.json
load-tests/summary.html
load-tests/summary.csv
/summary.json
/summary.html
/summary.csv

# Raw k6 timeline output (huge — tens of MB per run, easily regenerated by
# re-running the test with TIMELINE=1). HTML / Markdown / CSV summaries are
# kept; only the per-sample NDJSON is excluded.
*.ndjson

# Local backups created by the bootstrap helpers (e.g. users.json.bak).
*.bak

# Shimy load-test secrets (real phone/password pool for test users).
# The example template MUST stay in the repo as a reference.
load-tests/shimy/.secrets/*
!load-tests/shimy/.secrets/users.example.json

#Allure artifact files
allure-results

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

